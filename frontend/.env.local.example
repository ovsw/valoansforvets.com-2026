# Required local identity and Sanity connection values.
NEXT_PUBLIC_SITE_NAME="Your Site Name"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-23
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
OG_IMAGE_SECRET=generate-a-long-random-value
SANITY_API_READ_TOKEN=your-read-token

# Optional editor tooling.
SHADCNBLOCKS_API_KEY=your-key

# Server-only Trigger.dev key for this project's Development environment.
# CLI login runs the local worker; add this key when Next.js starts tasks.
# Never prefix this key with NEXT_PUBLIC_.
TRIGGER_SECRET_KEY=

# Clerk development application. Only the publishable key is public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CRM_STAFF_EMAILS=you@example.com

# Keep DATABASE_URL intact. This test flow uses the verified development branch.
PREVIEW_DATABASE_URL=

# Development email is off by default. Only the fixed allowlisted test address can receive mail.
RESEND_API_KEY=
RESEND_FROM="VA Loans for Vets <onboarding@resend.dev>"
TEST_EMAIL_ALLOWLIST=you@example.com
PREVIEW_EMAIL_ENABLED=false
